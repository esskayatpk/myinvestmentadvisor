# Copy this to .env and fill in your values
# The VITE_ vars are already in the root .env — this file just makes the sync
# script self-contained if you run it from a different location.

# ── Supabase (copy from root .env) ───────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# ── IBKR Gateway ─────────────────────────────────────────────────────────────
# Default: https://localhost:5000 (leave as-is unless you changed the port)
IBKR_GATEWAY_URL=https://localhost:5000

# ── Watch mode interval (seconds) ────────────────────────────────────────────
# How often to re-sync when running: npm run watch
IBKR_SYNC_INTERVAL_SEC=300
