# ── Required ──────────────────────────────────────────────────────────────────
# Supabase (same project as your POS app is fine)
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# ── Market Data APIs ──────────────────────────────────────────────────────────
# Alpha Vantage – free at https://www.alphavantage.co/support/#api-key
# Free tier: 25 req/day, 5 req/min  |  Use 'demo' for basic testing
VITE_ALPHA_VANTAGE_KEY=demo

# Polygon.io – free at https://polygon.io/
# Free tier: unlimited historical, 5 req/min, 15-min delayed real-time
VITE_POLYGON_KEY=your_polygon_key_here

# Finnhub – free at https://finnhub.io/
# Free tier: 60 req/min, real-time US stocks
VITE_FINNHUB_KEY=your_finnhub_key_here

# ── Forex (no key needed) ──────────────────────────────────────────────────────
# ExchangeRate-API: https://open.er-api.com/v6/latest/USD  (completely free)
# FRED (Federal Reserve): https://fred.stlouisfed.org  (no key for basic data)
